# Salin file ini jadi ".env" lalu isi nilainya. JANGAN upload .env ke GitHub.

# --- Wajib ---
GROQ_API_KEY=
PAIRING_NUMBER=
OWNER_NUMBERS=

# --- Database MongoDB ---
MONGODB_URI=

# --- Opsional ---
BOT_PREFIX=
SESSION_DIR=
YTDLP_COOKIES=
MAX_MEDIA_MINUTES=
MAX_MEDIA_MB=
# YTDLP_PATH=
# RICH_MARKDOWN=false

# --- Gambar AI realistis (opsional, Cloudflare Workers AI, gratis) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
AI_HISTORY=10
CF_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct
CF_CHAT_FALLBACK=true

# --- Jadibot (nomor lain jadi bot lewat .jadibot) ---
JADIBOT_ENABLED=true
JADIBOT_MAX=10
JADIBOT_SHARE_KEY=true

# --- Sewa jadibot (pembayaran QRIS via SyahPay) ---
JADIBOT_PAID=true
JADIBOT_PRICE_PER_DAY=1000
JADIBOT_PLANS=1,3,7,14,30,90,180,365
SYAHPAY_API_KEY=
SYAHPAY_BASE=https://syahpay.biz.id

# --- Menu dan premium ---
BOT_WEBSITE=https://contoh.com
PREMIUM_TOOLS=generate_image,draw_image
